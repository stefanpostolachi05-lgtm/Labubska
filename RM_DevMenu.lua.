local function interactWith(promptOrDetector)
    if fireproximityprompt then
        pcall(fireproximityprompt, promptOrDetector)
    elseif fireclickdetector then
        pcall(fireclickdetector, promptOrDetector)
    end
end

task.spawn(function()
    while true do
        task.wait(0.15)
        if S.autoLoot then
            local r = root()
            if r then
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector") then
                        local parentPart = obj.Parent
                        if parentPart and parentPart:IsA("BasePart") then
                            if (parentPart.Position - r.Position).Magnitude <= CFG.AutoLootDistance then
                                interactWith(obj)
                            end
                        elseif parentPart and parentPart:IsA("Model") then
                            local primary = parentPart.PrimaryPart or parentPart:FindFirstChildWhichIsA("BasePart", true)
                            if primary and (primary.Position - r.Position).Magnitude <= CFG.AutoLootDistance then
                                interactWith(obj)
                            end
                        end
                    end
                end
            end
        end
    end
end)

